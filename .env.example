# Copie este arquivo para .env e preencha os valores.

# Connection string do Postgres (ex: a variável DATABASE_URL gerada pelo
# plugin Postgres do Railway, algo como postgres://user:pass@host:port/db)
DATABASE_URL=

# String aleatória longa usada para assinar os tokens JWT de sessão.
# Gere uma com, por ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta em que a API/servidor Express sobe localmente (Railway define PORT sozinho em produção)
PORT=4000

# Opcional: defina como "false" para desativar SSL na conexão com o Postgres
# (útil só para um Postgres local sem SSL; no Railway deixe sem definir)
# DATABASE_SSL=false
